{
  "name": "kmt-legal-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0 <23 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "start:local": "node scripts/start-local-server.mjs",
    "lint": "next lint",
    "qa:local": "node scripts/plan23-local-qa.mjs",
    "qa:local:e2e": "node scripts/plan23-local-qa.mjs --include-e2e",
    "qa:local:release": "node scripts/plan23-local-qa.mjs --include-e2e --include-security-audit --local-release-candidate",
    "qa:db": "node scripts/plan23-local-qa.mjs --include-db",
    "qa:release": "node scripts/plan23-local-qa.mjs --include-e2e --include-db --include-security-audit --include-secret-scan --release-gate",
    "jobs:payments": "node scripts/payment-maintenance.mjs",
    "jobs:payments:watch": "node scripts/payment-maintenance.mjs --watch",
    "predeploy:payments": "node scripts/payment-predeploy-check.mjs",
    "security:audit": "npm audit --audit-level=high --omit=dev",
    "security:audit:all": "npm audit --audit-level=moderate",
    "security:secrets": "node scripts/security-secret-scan.mjs",
    "cloudflare:cache-rules": "node scripts/cloudflare-public-cache-rule.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-playwright-with-server.mjs",
    "test:e2e:smoke": "node scripts/run-playwright-with-server.mjs tests/e2e/mvp-smoke.spec.ts",
    "test:e2e:plan35": "node scripts/run-playwright-with-server.mjs tests/e2e/plan35-admin-operations.spec.ts --workers=1",
    "test:e2e:plan36": "node scripts/run-playwright-with-server.mjs tests/e2e/plan36-consultation-outcomes.spec.ts --workers=1",
    "test:e2e:plan37": "node scripts/run-playwright-with-server.mjs tests/e2e/plan37-consultation-overdue-unbooked.spec.ts --workers=1",
    "test:e2e:db": "node scripts/run-playwright-with-server.mjs tests/e2e/db-backed.spec.ts tests/e2e/plan35-db-backed.spec.ts --workers=1",
    "test:e2e:live-admin": "playwright test tests/e2e/live-admin-smoke.spec.ts --workers=1",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "stitch:assets": "node scripts/localize-stitch-assets.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.9",
    "@fontsource/inter": "^5.2.8",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/nextjs": "^10.64.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.3.0",
    "next": "15.5.25",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "pg": "^8.22.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.25",
    "jsdom": "^28.1.0",
    "postcss": "8.5.28",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "prisma": {
      "mysql2": "3.24.4"
    },
    "@hono/node-server": "1.19.15",
    "postcss": "8.5.28",
    "sharp": "0.35.4",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "@prisma/dev": {
      "valibot": "1.4.2"
    }
  }
}
